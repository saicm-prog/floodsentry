{
  "name": "field-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:all": "npm-run-all --parallel dev dev:api",
    "data:download": "node scripts/download-county-zip-crosswalk.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test server/*.test.mjs",
    "model:check": "node --input-type=module -e \"import * as ort from 'onnxruntime-node'; const s=await ort.InferenceSession.create(process.env.FLOOD_SENTRY_MODEL_PATH || 'models/Exp1_BestModel.onnx'); console.log(s.inputNames, s.outputNames, s.inputMetadata)\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "npm-run-all": "latest",
    "onnxruntime-node": "^1.30.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
