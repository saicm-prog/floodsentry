{
  "name": "field-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:all": "npm-run-all --parallel dev dev:api",
    "data:download": "node scripts/download-county-zip-crosswalk.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test server/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "npm-run-all": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
